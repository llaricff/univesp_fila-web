# Copie este arquivo para ".env" e ajuste.

# URL base da API do back-end (.NET). Se ficar vazio, o front usa o modo simulado (mock),
# que funciona sem back-end e serve para testar a tela.
VITE_API_URL=

# Porta/endereço do back-end usados pelo proxy do Vite em desenvolvimento.
VITE_PROXY_TARGET=http://localhost:5000
